  "components": {
    "schemas": {
      "DetectionIn": {
        "properties": {
          "cls": {
            "type": "string",
            "maxLength": 40,
            "title": "Cls"
          },
          "conf": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Conf"
          },
          "in_seat": {
            "type": "boolean",
            "title": "In Seat",
            "default": false
          },
          "in_table": {
            "type": "boolean",
            "title": "In Table",
            "default": false
          },
          "seat_overlap": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Seat Overlap",
            "default": 0
          },
          "table_overlap": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Table Overlap",
            "default": 0
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          }
        },
        "type": "object",
        "required": [
          "cls",
          "conf"
        ],
        "title": "DetectionIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestIn": {
        "properties": {
          "camera_id": {
